{
  "type": "heterogeneous",
  "sql_transforms": [
    "building.sql",
    "buildingsurface_features.sql",
    "surface_shading_metrics.sql",
    "construction_material_totals.sql",
    "comp_element.sql",
    "comp_zone.sql",
    "comp_aperture.sql",
    "zones_zone.sql",
    "edge_zones.sql",
    "edge_zones_building.sql"
  ],
  "nodes": [
    {
      "table": "building"
    },
    {
      "table": "zones_zone"
    }
  ],
  "edges": [
    {
      "edge_src": "edge_zones",
      "src_cat": "zones_zone",
      "src_col": "zone_1_name",
      "tgt_cat": "zones_zone",
      "tgt_col": "zone_2_name",
      "rel": "adjacent_zone",
      "bidirectional": true
    },
    {
      "edge_src": "edge_zones_building",
      "src_cat": "zones_zone",
      "src_col": "zone_name",
      "tgt_cat": "building",
      "tgt_col": "building_instance_name",
      "rel": "belongs_to",
      "bidirectional": true
    }
  ]
}
