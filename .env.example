# Copy to .env and adjust. .env is git-ignored and must never be committed.
#
# Single source of truth for the database connection. Every module, notebook and
# script in this repository reads this one variable through beg.db.get_engine().

BEG_DSN=postgresql+psycopg2://beg:change-me@127.0.0.1:5432/beg

# Used by docker-compose.yml when you run the bundled PostgreSQL service.
# POSTGRES_PASSWORD is read only when the data volume is first created; editing it
# later does not change the password of a database that already exists.
# See docs/database.md.
POSTGRES_USER=beg
POSTGRES_PASSWORD=change-me
POSTGRES_DB=beg
# The standard PostgreSQL port. If something already listens on 5432 on this
# machine, pick another (5433 is the usual second choice) and change the port in
# BEG_DSN above to match - the two must always agree.
POSTGRES_PORT=5432

# Optional: where raw inputs and generated artefacts live (defaults shown).
# BEG_DATA_DIR=./data
# BEG_OUTPUT_DIR=./outputs
